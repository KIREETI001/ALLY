# ALLY environment variables — copy this file to `.env.local` and fill in the real values.
# Do NOT commit `.env.local` to git.

# Anthropic API key (for /api/parse-discharge and /api/chat)
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API)
# Pick the Singapore (ap-southeast-1) region when you create the project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — only set this for local dev callbacks. Vercel sets its own automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
